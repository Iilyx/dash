# Скопируй в .env и заполни
PORT=8040

# Postgres (URL-формат). Подставляется в handler вместо строки подключения из mrt
PG_CONNECTION_STRING=postgres://user:password@127.0.0.1:5432/dbname
# Если нужен SSL (облачные БД), поставь true
PG_SSL=false

# Лицензионный ключ Stimulsoft (Reports + Dashboards)
STIMULSOFT_LICENSE_KEY=

# Путь к твоему отчёту/дашборду
REPORT_FILE=./reports/Report.mrt
