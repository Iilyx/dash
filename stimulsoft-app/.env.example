# Скопируй в .env и заполни
PORT=8040

# Postgres (URL-формат). Подставляется в /handler вместо строки из mrt
# пример: postgres://admin:admin123@127.0.0.1:54322/app
PG_CONNECTION_STRING=postgres://user:password@127.0.0.1:5432/dbname
PG_SSL=false

# Лицензионный ключ Stimulsoft (Reports + Dashboards)
STIMULSOFT_LICENSE_KEY=

# Путь к .mrt (абсолютный или относительно stimulsoft-app/)
REPORT_FILE=../test.mrt
