POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=app
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://admin:admin123@127.0.0.1:5432/app

CATALOG_PATH=catalog.json
CATALOG_PAGES_DIR=catalog_pages
ASK_DUMP_PATH=ask_trace.txt

LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=120

# Qwen 3.5 thinking
LLM_ENABLE_THINKING=true
# low | medium | high | xhigh | none
LLM_REASONING_EFFORT=low
# LLM_THINKING_BUDGET=

HOST=127.0.0.1
PORT=8090
LOG_LEVEL=INFO

# Stimulsoft viewer (view_dashboard.py): .mrt + Postgres
# stimulsoft-reports==2024.3.3 + stimulsoft-dashboards==2024.3.3
# (2024.3.3 — last before Format() rewrite in 2024.3.4)
MRT_PATH=test.mrt
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8040
VIEWER_OPEN=1
# колонки на полосе Parameters (1 = построчно)
PARAMETERS_PANEL_COLUMNS=3
# Лицензии Stimulsoft (Base64). В JS один Key — приоритет ниже.
# Ultimate / общий (покрывает Reports + Dashboards) — предпочтительно:
STIMULSOFT_LICENSE_KEY=
# STIMULSOFT_LICENSE_FILE=stimulsoft.key
# Отдельные продуктовые ключи (если нет Ultimate):
STIMULSOFT_REPORTS_LICENSE_KEY=
STIMULSOFT_DASHBOARDS_LICENSE_KEY=
# STIMULSOFT_REPORTS_LICENSE_FILE=stimulsoft-reports.key
# STIMULSOFT_DASHBOARDS_LICENSE_FILE=stimulsoft-dashboards.key
