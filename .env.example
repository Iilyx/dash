POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=app
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://admin:admin123@127.0.0.1:5432/app

# .mrt для viewer/host (test.mrt — обезличка; полный файл — свой путь)
MRT_PATH=test.mrt
# MRT_PATH=/absolute/path/to/full.mrt
CATALOG_PATH=catalog.json
CATALOG_PAGES_DIR=catalog_pages
ASK_DUMP_PATH=ask_trace.txt

LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=120

# Qwen 3.5 thinking
LLM_ENABLE_THINKING=true
# low | medium | high | xhigh | none
LLM_REASONING_EFFORT=low
# LLM_THINKING_BUDGET=

HOST=127.0.0.1
PORT=8090
LOG_LEVEL=INFO

# Stimulsoft viewer (view_dashboard.py)
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8040
VIEWER_OPEN=1
# 1 = ждать Submit — выбранные фильтры уходят в SQL @param; 0 = первый SQL без выбора
FORCE_REQUEST_PARAMETERS=1
# 1 = AllowUseAsSqlParameter у RFU (иначе выбранное не попадает в источники)
FORCE_ALLOW_SQL_PARAMETER=1
# Viewer патчит Databases/DataSources → StiPostgreSQL* и форсит database=PostgreSQL
# Проблемы источников смотри /debug → source_problems / mrt_patch.source_issues / sql_log
# Panel = полоса параметров сверху; Dialog = модальное окно
FORCE_PARAMETERS_MODE=Panel
# 1 = Columns→Items без SQL (списки пустые); 0 = грузить DialogInfo из БД
FORCE_SKIP_COLUMNS_PRELOAD=0
# ширина полей фильтров (px) и число колонок на полосе
PARAMETER_WIDTH=280
PARAMETERS_PANEL_COLUMNS=3
# DashboardViewerSettings=671 (toolbar+Parameters, без ResetAllFilters)
FORCE_DASHBOARD_TOOLBAR=1
