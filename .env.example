POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=app
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54322
MRT_PATH=test.mrt
# Папка с парами name.md + name.mrt (промпты для выбора дашборда)
DASHBOARDS_DIR=dashboards
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8040
VIEWER_OPEN=0
# Ширина контролов панели фильтров (px). По умолчанию 180.
FILTER_PARAM_WIDTH=180
EXPORT_DIR=exports
# Скрин: вкладка /open + GET /shot (таймаут ожидания вкладки, мс)
SHOT_WAIT_MS=90000

# LLM для POST /filters {"question":"…"} (выбор дашборда + result)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
# Лимит ответа модели. Пусто = параметр не отправляем.
LLM_MAX_TOKENS=2048
# Размышление (thinking): 0 выкл / 1 вкл
LLM_REASONING=0
# low|medium|high — только при LLM_REASONING=1
LLM_REASONING_EFFORT=medium

# Stimulsoft Dashboards.PYTHON 2024.2.2 (JS engine).
# .env в .gitignore — ключ на git НЕ попадает; на каждой машине свой.
# Preview в Desktop Designer ≠ viewer: designer логинится в аккаунт,
# а /viewer читает только переменные ниже. Без ключа — серый DEMO в PDF
# и битые картинки чартов/Cards в Excel («Не удалось отобразить рисунок»).
# Ключ из кабинета должен быть для Dashboards.JS / PYTHON линейки 2024.2.x.
STIMULSOFT_DASHBOARDS_LICENSE_KEY=
STIMULSOFT_REPORTS_LICENSE_KEY=
# Или путь к .key файлу (локально, не в web-root):
# STIMULSOFT_DASHBOARDS_LICENSE_FILE=private/stimulsoft.key
