<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Stimulsoft .NET</title>
    <style>
        html, body { margin: 0; padding: 0; height: 100%; width: 100%; overflow: hidden; }
        #nav {
            position: fixed; z-index: 10000; top: 0; right: 0;
            padding: 6px 10px; background: rgba(255,255,255,.9);
            font: 13px Segoe UI, sans-serif; border-bottom-left-radius: 6px;
        }
        #nav a { margin-left: 10px; color: #1a5fb4; text-decoration: none; }
        #host { position: absolute; inset: 0; }
    </style>
</head>
<body>
    <div id="nav">
        .NET 2024.3.3
        <a asp-controller="Viewer" asp-action="Index">Viewer</a>
        <a asp-controller="Designer" asp-action="Index">Designer</a>
        <a href="/dbcheck">dbcheck</a>
    </div>
    <div id="host">
        @RenderBody()
    </div>
</body>
</html>
