@using System.Web.UI.WebControls
@{
    ViewData["Title"] = "Designer";
}

@Html.StiNetCoreDesigner(new StiNetCoreDesignerOptions()
{
    Width = Unit.Percentage(100),
    Height = Unit.Percentage(100),
    Actions =
    {
        GetReport = "GetReport",
        DesignerEvent = "DesignerEvent"
    },
    Appearance =
    {
        FullScreenMode = true
    }
})
