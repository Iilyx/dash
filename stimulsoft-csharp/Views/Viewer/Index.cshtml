@using System.Web.UI.WebControls
@{
    ViewData["Title"] = "Viewer";
}

@Html.StiNetCoreViewer(new StiNetCoreViewerOptions()
{
    Width = Unit.Percentage(100),
    Height = Unit.Percentage(100),
    Actions =
    {
        GetReport = "GetReport",
        ViewerEvent = "ViewerEvent"
    },
    Appearance =
    {
        FullScreenMode = true,
        ScrollbarsMode = true
    }
})
