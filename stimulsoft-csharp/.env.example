# --- локально (dotnet run) ---
ASPNETCORE_URLS=http://127.0.0.1:8050
MRT_PATH=../test.mrt

# --- Docker (docker compose) ---
VIEWER_PORT=8050
# путь к .mrt НА ХОСТЕ (смонтируется в /data/Report.mrt)
MRT_HOST_PATH=./reports/Report.mrt

# Postgres из контейнера до БД на хосте:
PG_CONNECTION_STRING=postgres://admin:admin123@host.docker.internal:54322/app
# Postgres из этого же compose (--profile db):
# PG_CONNECTION_STRING=postgres://admin:admin123@postgres:5432/app

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=app
POSTGRES_PORT=54322

STIMULSOFT_LICENSE_KEY=

