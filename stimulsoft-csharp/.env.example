VIEWER_PORT=8050

# .mrt на хосте → /data/Report.mrt в контейнере
MRT_HOST_PATH=./reports/Report.mrt
# Windows: MRT_HOST_PATH=C:/Users/You/Report.mrt

# БД снаружи. Без кавычек. Docker-хост = host.docker.internal
# Вариант A — URL (внутри приложения станет Host=...;):
PG_CONNECTION_STRING=postgres://admin:admin123@host.docker.internal:54322/app
# Вариант B — сразу key=value (тоже ок):
# PG_CONNECTION_STRING=Host=host.docker.internal;Port=54322;Database=app;Username=admin;Password=admin123

# если PG_CONNECTION_STRING пустой — соберём из полей:
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=54322
POSTGRES_DB=app
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

STIMULSOFT_LICENSE_KEY=
