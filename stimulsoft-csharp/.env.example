VIEWER_PORT=8050

# .mrt на хосте → /data/Report.mrt в контейнере
MRT_HOST_PATH=./reports/Report.mrt
# Windows: MRT_HOST_PATH=C:/Users/You/Report.mrt

# БД уже запущена снаружи.
# Docker → хост: host.docker.internal + порт ПРОБРОСА (у тебя 54322)
PG_CONNECTION_STRING=postgres://admin:admin123@host.docker.internal:54322/app

# запасной вариант (если PG_CONNECTION_STRING пустой)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=54322
POSTGRES_DB=app
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

STIMULSOFT_LICENSE_KEY=
