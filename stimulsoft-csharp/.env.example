VIEWER_PORT=8050

# .mrt на хосте (volume → /data/Report.mrt в контейнере)
MRT_HOST_PATH=./reports/Report.mrt
# MRT_HOST_PATH=/absolute/path/dashboard.mrt

# Уже существующая БД. Из Docker-хост = host.docker.internal
# (порт как в корневом .env / docker-compose, у тебя часто 54322)
PG_CONNECTION_STRING=postgres://admin:admin123@host.docker.internal:54322/app

# Либо те же поля, что в корневом .env — compose подхватит ../.env.
# Для Docker обязательно не 127.0.0.1, а host.docker.internal:
# POSTGRES_HOST=host.docker.internal
# POSTGRES_PORT=54322
# POSTGRES_DB=app
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=admin123

STIMULSOFT_LICENSE_KEY=
